{
  "name": "hsarriver-turbo-desktop",
  "version": "0.1.0",
  "description": "HSArriver Turbo Electron + React desktop client",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:react\" \"npm:dev:electron\"",
    "dev:react": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build:react": "vite build",
    "build:dir": "npm run build:react && electron-builder --win --x64 --dir --publish never",
    "build:zip": "npm run build:react && electron-builder --win --x64 --dir --publish never && node scripts/make-zip.cjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hsarriver.turbo",
    "productName": "HSArriver Turbo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-react/**/*"
    ],
    "asar": true,
    "artifactName": "HSArriverTurbo-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "extraResources": [
      {
        "from": "..",
        "to": "engine",
        "filter": [
          "*.py",
          "src/**/*.py",
          "constants/**/*",
          "assets/**/*",
          "web/**/*",
          "cards.json",
          "requirements.txt",
          "LICENSE"
        ]
      },
      {
        "from": "engine-build/HSArriverTurboEngine",
        "to": "engine/HSArriverTurboEngine",
        "filter": ["**/*"]
      }
    ]
  }
}
